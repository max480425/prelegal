BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO

# Paths are resolved from the repo root (no ../ prefixes).
DOCUMENTS_DIR=generated_documents
TEMPLATES_DIR=templates

# Static frontend export served by FastAPI (built with `npm run build`)
FRONTEND_DIR=frontend/out

# SQLite database file. The Docker container deletes this file on start so
# the DB is created from scratch each time the container is brought up.
DATABASE_PATH=prelegal.db

# JWT session cookie. Leave empty to generate a random secret at startup
# (sessions then last for the process lifetime). Set an explicit value only
# if you need sessions to survive restarts outside Docker.
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# OpenRouter API key for the AI chat (PL-5). Lives in the REPO-ROOT .env,
# which docker-compose passes through to the container. Leave empty to run
# without AI chat — GET /api/chat/greeting still works, POST /api/chat/message
# returns 503.
OPENROUTER_API_KEY=

# Max chat requests per IP per minute (0 disables the limiter). Chat is
# public and each turn spends OpenRouter credit.
CHAT_RATE_LIMIT=20
